# ─────────────────────────────────────────────────────────────────────────────
# Solana LP Agent — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Wallet ──────────────────────────────────────────────────────────────────
# Your Solana wallet private key in base58 format
# NEVER commit this to git — use .gitignore
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ── Solana RPC ───────────────────────────────────────────────────────────────
# Use a paid RPC for reliability (Helius, QuickNode, Triton recommended)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# ── Token Mints ──────────────────────────────────────────────────────────────
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
HYPE_MINT=YOUR_HYPE_TOKEN_MINT_ADDRESS

# ── Meteora Pool Addresses ───────────────────────────────────────────────────
# Find these at app.meteora.ag — use the DLMM pool addresses
SOL_USDC_POOL=YOUR_SOL_USDC_METEORA_DLMM_POOL_ADDRESS
HYPE_USDC_POOL=YOUR_HYPE_USDC_METEORA_DLMM_POOL_ADDRESS

# ── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Comma-separated list of allowed Telegram user IDs (leave blank to allow all)
TELEGRAM_ALLOWED_USERS=123456789,987654321

# ── Price Data APIs ──────────────────────────────────────────────────────────
BIRDEYE_API_KEY=your_birdeye_api_key_here

# ── Capital Limits ───────────────────────────────────────────────────────────
# Maximum USD capital to deploy per pool
MAX_CAPITAL_SOL_USDC=5000
MAX_CAPITAL_HYPE_USDC=3000

# ── Rebalancing ──────────────────────────────────────────────────────────────
# Trigger rebalance when price drifts this % from center (default: 1.2%)
REBALANCE_THRESHOLD=0.012
# Breakout detection threshold (default: 2.5%)
BREAKOUT_THRESHOLD=0.025
# Cooldown after rebalance in milliseconds (default: 15 min)
COOLDOWN_MS=900000
# Fakeout delay before confirming rebalance (default: 10 min)
FAKEOUT_DELAY_MS=600000

# ── Risk Management ───────────────────────────────────────────────────────────
# Maximum volatility % before halting (default: 5%)
MAX_VOL_PCT=5.0
# Minimum USDC reserve percentage (default: 10%)
MIN_USDC_RESERVE_PCT=0.10

# ── Trading ──────────────────────────────────────────────────────────────────
# Slippage tolerance in basis points (default: 50 = 0.5%)
SLIPPAGE_BPS=50

# ── Compounding ──────────────────────────────────────────────────────────────
# Minimum fee in USD before compounding triggers
MIN_COMPOUND_USD=10
# Default compound mode: balanced | aggressive | conservative
COMPOUND_MODE=balanced

# ── Agent Loop ───────────────────────────────────────────────────────────────
# How often the main loop runs in milliseconds (default: 30s)
LOOP_INTERVAL_MS=30000

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
