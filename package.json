{
  "name": "solana-lp-agent",
  "version": "1.0.0",
  "description": "Autonomous Solana LP Agent for HYPE-USDC and SOL-USDC (Meteora DLMM)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "pm2": "pm2 start src/index.js --name lp-agent --restart-delay=5000 --max-restarts=10",
    "logs": "pm2 logs lp-agent",
    "stop": "pm2 stop lp-agent"
  },
  "dependencies": {
    "@solana/web3.js": "^1.91.0",
    "@meteora-ag/dlmm": "^1.0.0",
    "bn.js": "^5.2.1",
    "axios": "^1.6.0",
    "bs58": "^5.0.0",
    "dotenv": "^16.3.0",
    "node-telegram-bot-api": "^0.64.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
